              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          },
          "503": {
            "description": "Caught checked storage IOException; refresh before retrying. A change may already have committed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          },
          "403": {
            "description": "Controlled ArcFlow inactive-account or domain publication/assignment rejection. Outer RuoYi authentication/permission filters can still use host-owned behavior described by default.",
