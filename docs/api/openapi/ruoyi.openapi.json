{
  "openapi": "3.1.0",
  "info": {
    "title": "ArcFlow RuoYi native ArcFlow overlay",
    "version": "0.1.0-SNAPSHOT",
    "description": "Checked-in contract, not a deployed Swagger endpoint. No login or single-request GET route is implemented. RuoYi owns token authentication, permissions, sessions and host error behavior. Only these nine /arcflow mappings belong to this overlay. Configure the server URL/token transport for your actual RuoYi host. No Basic authentication, quote/scenario controller or added login route."
  },
  "servers": [
    {
      "url": "/",
      "description": "Relative to the configured RuoYi host; frontend dev-api/prod-api are proxy prefixes."
    }
  ],
  "security": [
    {
      "ruoyiBearer": []
    }
  ],
  "tags": [
    {
      "name": "native"
    }
  ],
